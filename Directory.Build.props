<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <!-- Projects have short names (Partners.API); namespaces carry the product prefix (ValetaxTest.Partners.API). -->
    <RootNamespace Condition="!$(MSBuildProjectName.StartsWith('ValetaxTest.'))">ValetaxTest.$(MSBuildProjectName)</RootNamespace>
  </PropertyGroup>
</Project>
