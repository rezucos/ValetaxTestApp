{
  "Service": {
    "Name": "wallets"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://+:8080", "Protocols": "Http1" }
    }
  },
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=wallets;Username=wallets;Password=wallets"
  },
  "Kafka": {
    "BootstrapServers": "localhost:29092",
    "ClientId": "wallets"
  }
}
