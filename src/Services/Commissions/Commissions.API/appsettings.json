{
  "Service": {
    "Name": "commissions"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Grpc": "Warning",
      "Polly": "None"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://+:8080", "Protocols": "Http1" },
      "Grpc": { "Url": "http://+:8081", "Protocols": "Http2" }
    }
  },
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=commissions;Username=commissions;Password=commissions"
  },
  "Kafka": {
    "BootstrapServers": "localhost:29092",
    "ClientId": "commissions"
  },
  "Services": {
    "Partners": {
      "GrpcAddress": "dns:///localhost:5102"
    }
  },
  "Commissions": {
    "MaxLevels": 10
  }
}
