{
  "Service": {
    "Name": "events"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Grpc": "Warning",
      "Polly": "None"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://+:8080", "Protocols": "Http1" }
    }
  },
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=events;Username=events;Password=events"
  },
  "Kafka": {
    "BootstrapServers": "localhost:29092",
    "ClientId": "events"
  },
  "Services": {
    "Partners": {
      "GrpcAddress": "dns:///localhost:5102"
    }
  }
}
