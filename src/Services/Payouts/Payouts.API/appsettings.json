{
  "Service": {
    "Name": "payouts"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Grpc": "Warning",
      "Polly": "None"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://+:8080", "Protocols": "Http1" }
    }
  },
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=payouts;Username=payouts;Password=payouts"
  },
  "Kafka": {
    "BootstrapServers": "localhost:29092",
    "ClientId": "payouts"
  },
  "Services": {
    "Commissions": {
      "GrpcAddress": "dns:///localhost:5302"
    }
  },
  "Payouts": {
    "Interval": "00:01:00",
    "SchedulerEnabled": true,
    "StepTimeout": "00:00:30",
    "MaxRetryDelay": "00:05:00",
    "TimeoutCheckInterval": "00:00:10",
    "MaxItemsPerPayout": 500,
    "MaxPartnersPerRun": 1000
  }
}
