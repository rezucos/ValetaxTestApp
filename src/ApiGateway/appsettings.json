{
  "Service": {
    "Name": "gateway"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.DataProtection": "Error",
      "Yarp": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ"
      }
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://+:8080", "Protocols": "Http1" }
    }
  },
  "ApiDocuments": [
    { "Name": "partners", "Title": "Partners (users and partner tree)" },
    { "Name": "events", "Title": "Events (profit events)" },
    { "Name": "commissions", "Title": "Commissions (accrual, schema administration)" },
    { "Name": "wallets", "Title": "Wallets (balances, payout history)" },
    { "Name": "payouts", "Title": "Payouts (saga orchestrator)" }
  ],
  "ReverseProxy": {
    "Routes": {
      "users": { "ClusterId": "partners", "Match": { "Path": "/api/users/{**rest}" } },
      "events": { "ClusterId": "events", "Match": { "Path": "/api/events/{**rest}" } },
      "commissions": { "ClusterId": "commissions", "Match": { "Path": "/api/commissions/{**rest}" } },
      "commission-schema": { "ClusterId": "commissions", "Match": { "Path": "/api/admin/commission-schema/{**rest}" } },
      "wallets": { "ClusterId": "wallets", "Match": { "Path": "/api/wallets/{**rest}" } },
      "wallets-admin": { "ClusterId": "wallets", "Match": { "Path": "/api/admin/wallets/{**rest}" } },
      "payouts": { "ClusterId": "payouts", "Match": { "Path": "/api/payouts/{**rest}" } },

      "openapi-partners": {
        "ClusterId": "partners",
        "Match": { "Path": "/openapi/partners.json" },
        "Transforms": [ { "PathSet": "/openapi/v1.json" } ]
      },
      "openapi-events": {
        "ClusterId": "events",
        "Match": { "Path": "/openapi/events.json" },
        "Transforms": [ { "PathSet": "/openapi/v1.json" } ]
      },
      "openapi-commissions": {
        "ClusterId": "commissions",
        "Match": { "Path": "/openapi/commissions.json" },
        "Transforms": [ { "PathSet": "/openapi/v1.json" } ]
      },
      "openapi-wallets": {
        "ClusterId": "wallets",
        "Match": { "Path": "/openapi/wallets.json" },
        "Transforms": [ { "PathSet": "/openapi/v1.json" } ]
      },
      "openapi-payouts": {
        "ClusterId": "payouts",
        "Match": { "Path": "/openapi/payouts.json" },
        "Transforms": [ { "PathSet": "/openapi/v1.json" } ]
      }
    },
    "Clusters": {
      "partners": { "Destinations": { "partners": { "Address": "http://partners:8080" } } },
      "events": { "Destinations": { "events": { "Address": "http://events:8080" } } },
      "commissions": { "Destinations": { "commissions": { "Address": "http://commissions:8080" } } },
      "wallets": { "Destinations": { "wallets": { "Address": "http://wallets:8080" } } },
      "payouts": { "Destinations": { "payouts": { "Address": "http://payouts:8080" } } }
    }
  }
}
