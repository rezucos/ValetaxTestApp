{
  "Logging": {
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": false,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://localhost:5000", "Protocols": "Http1" }
    }
  },
  "ReverseProxy": {
    "Clusters": {
      "partners": { "Destinations": { "partners": { "Address": "http://localhost:5101" } } },
      "events": { "Destinations": { "events": { "Address": "http://localhost:5201" } } },
      "commissions": { "Destinations": { "commissions": { "Address": "http://localhost:5301" } } },
      "wallets": { "Destinations": { "wallets": { "Address": "http://localhost:5401" } } },
      "payouts": { "Destinations": { "payouts": { "Address": "http://localhost:5501" } } }
    }
  }
}
